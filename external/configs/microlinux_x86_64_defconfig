# --- Boot loader: GRUB 2 for BIOS (i386-pc) and UEFI (x86_64-efi); the GRUB
#     tools on the target let ml-install set up BIOS boot on the installed disk
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat iso9660 part_msdos part_gpt biosdisk normal search search_fs_file search_fs_uuid search_label configfile echo test all_video vbe vga video_bochs video_cirrus gfxterm font gzio ls cat reboot halt sleep regexp minicmd"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/grub-embed-pc.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 iso9660 part_msdos part_gpt normal efi_gop efi_uga search search_fs_file search_fs_uuid search_label configfile echo test all_video gfxterm font gzio loadenv ls cat reboot halt sleep regexp minicmd chain"
# The built-in configs run before GRUB's script parser is loaded: plain
# commands only (no if/fi, no comments). UEFI: grub.cfg next to the loader
# (live medium, installed system, dual boot), else find the live medium.
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/grub-embed.cfg"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# --- Secure Boot: Microsoft-signed shim (Debian); post-image.sh signs GRUB and
#     the kernel with keys/secureboot (see docs/SECUREBOOT.md)
BR2_PACKAGE_SHIM_SIGNED_BIN=y

