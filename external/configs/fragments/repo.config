# MicroLinux package repository (all architectures).
#
# Every package enabled here is built like the rest of the system, then moved
# out of the root filesystem into its own mlpkg package by
# board/microlinux/repo-split.py, together with each dependency that the base
# system doesn't already contain (dependencies become packages too). The repo
# is written to images/repo/ (scripts/build.sh copies it to ../microlinux-repo/<arch>/).
# A package that the base system itself needs stays in the base system.
# "[category: ...]" in a section heading names its category in the package
# browser (CATEGORIES file); dependencies are listed as "Libraries".

# --- Programming languages and development  [category: Development]
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_BZIP2=y
