# --- Desktop (KDE edition): KDE Plasma 6 on Wayland (KWin), with the KDE apps.
# The KDE packages are in kde-packages.config (generated by scripts/kde-gen.py).
# Qt for Plasma: QML/Quick, Wayland, shaders, multimedia, SQL (SQLite)
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_PRINTSUPPORT=y
BR2_PACKAGE_QT6BASE_SQL=y
BR2_PACKAGE_QT6BASE_SQLITE=y
BR2_PACKAGE_QT6BASE_XML=y
# (SDDM needs Qt Test and QuickTest to build)
BR2_PACKAGE_QT6BASE_TEST=y
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_QT6SHADERTOOLS=y
BR2_PACKAGE_QT6CORE5COMPAT=y
BR2_PACKAGE_QT6MULTIMEDIA=y
BR2_PACKAGE_QT6MULTIMEDIA_FFMPEG=y
BR2_PACKAGE_QT6MULTIMEDIA_PULSEAUDIO=y
# Wayland: KWin's DRM backend (GBM, libinput, seat management), Xwayland for X11 programs
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_LIBDISPLAY_INFO=y
BR2_PACKAGE_LCMS2=y
BR2_PACKAGE_LIBEPOXY=y
# session and system services Plasma talks to
BR2_PACKAGE_POLKIT=y
BR2_PACKAGE_UPOWER=y
BR2_PACKAGE_UDISKS=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
# login screen
BR2_PACKAGE_KDE_SDDM=y
# session tracking for KWin, polkit and the login screen (BusyBox init, no systemd)
BR2_PACKAGE_KDE_ELOGIND=y
BR2_PACKAGE_KDE_ACCOUNTSSERVICE=y
