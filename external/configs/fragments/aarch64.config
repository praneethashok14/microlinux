# MicroLinux: aarch64 (64-bit ARM)

# --- Architecture: generic ARMv8.0-A so the image runs on any arm64 CPU
BR2_aarch64=y
BR2_cortex_a53=y

# --- Kernel: arm64 defconfig trimmed by the fragments, EFI zboot image
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/linux-common.fragment $(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/linux-aarch64.fragment"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="vmlinuz.efi"

# --- Firmware for common NICs / Wi-Fi / Bluetooth found on arm64 boards and laptops
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y

# --- Boot loader: GRUB 2 arm64-efi (arm64 has no BIOS)
BR2_TARGET_GRUB2_ARM64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 iso9660 part_msdos part_gpt normal efi_gop search search_fs_file search_fs_uuid search_label configfile echo test all_video gfxterm font gzio loadenv ls cat reboot halt sleep regexp minicmd chain"
# The built-in configs run before GRUB's script parser is loaded: plain
# commands only (no if/fi, no comments). UEFI: grub.cfg next to the loader
# (live medium, installed system, dual boot), else find the live medium.
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/grub-embed.cfg"
