# MicroLinux: settings shared by every architecture

# --- Build
BR2_PER_PACKAGE_DIRECTORIES=y
# fetch from the Buildroot source mirror first (same tarballs, hash-checked), upstream as fallback
BR2_PRIMARY_SITE="https://sources.buildroot.net"
BR2_CCACHE=y
BR2_CCACHE_DIR="/mnt/lima-mlbuild/ccache"
BR2_OPTIMIZE_S=y

# --- Toolchain: glibc is required for EL7 binary compatibility
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_18=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_GLIBC_UTILS=y
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ENABLE_LOCALE_WHITELIST="C en_US"

# --- System
BR2_TARGET_GENERIC_HOSTNAME="microlinux"
BR2_TARGET_GENERIC_ISSUE="MicroLinux"
BR2_TARGET_GENERIC_ROOT_PASSWD="microlinux"
BR2_TARGET_GENERIC_PASSWD_SHA512=y
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_MERGED_USR=y
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
BR2_TARGET_TZ_INFO=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/post-image.sh"

# --- Kernel: 6.18 LTS, arch default config + board/microlinux/linux-*.fragment
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.62"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- Core userland
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_FSCK=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_UNSHARE=y
BR2_PACKAGE_UTIL_LINUX_NSENTER=y
BR2_PACKAGE_UTIL_LINUX_SETPRIV=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
BR2_PACKAGE_UTIL_LINUX_HWCLOCK=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_PARTED=y
# boot entries in the UEFI firmware (ml-install, dual boot)
BR2_PACKAGE_EFIBOOTMGR=y
BR2_PACKAGE_SQUASHFS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_BINUTILS_TARGET=y
BR2_PACKAGE_PAX_UTILS=y
BR2_PACKAGE_DBUS=y

# --- Networking
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IW=y
# Wi-Fi regulatory database (allowed channels/power per country)
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
# BR2_PACKAGE_OPENSSH_SERVER is not set
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# --- EL7 compatibility libraries (see docs/EL7-COMPAT.md)
BR2_PACKAGE_LIBXCRYPT=y
BR2_PACKAGE_LIBXCRYPT_COMPAT=y
BR2_PACKAGE_NCURSES5_COMPAT=y
BR2_PACKAGE_EL7_RUNTIME=y
BR2_PACKAGE_EL10_RUNTIME=y
BR2_PACKAGE_DEBIAN_RUNTIME=y

# --- Graphics: Xorg (modesetting + fbdev fallback), Mesa software GL
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XAPP_XAUTH=y
BR2_PACKAGE_XAPP_XRANDR=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XAPP_SETXKBMAP=y
BR2_PACKAGE_XAPP_XDPYINFO=y
BR2_PACKAGE_XAPP_XPROP=y
BR2_PACKAGE_XAPP_XWININFO=y
BR2_PACKAGE_XDATA_XCURSOR_THEMES=y
BR2_PACKAGE_XLIB_LIBXCOMPOSITE=y
BR2_PACKAGE_XLIB_LIBXDAMAGE=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_XLIB_LIBXTST=y
BR2_PACKAGE_XLIB_LIBXCURSOR=y
BR2_PACKAGE_XLIB_LIBXI=y
BR2_PACKAGE_XLIB_LIBXINERAMA=y
BR2_PACKAGE_XLIB_LIBXFT=y
BR2_PACKAGE_XLIB_LIBXPM=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
# OpenGL ES (libGLESv2, ES contexts in EGL): programs using wgpu fall back to it
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# --- Desktop: LXQt 2.4 (Qt 6) with the Openbox window manager. GTK3 stays:
# Firefox and Settings (ml-settings) use it.
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_DBUS=y
BR2_PACKAGE_QT6BASE_XCB=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="xcb"
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_DESKTOP=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_GIF=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_OPENBOX=y
BR2_PACKAGE_LXQT_SESSION=y
BR2_PACKAGE_LXQT_PANEL=y
BR2_PACKAGE_LXQT_RUNNER=y
BR2_PACKAGE_LXQT_NOTIFICATIOND=y
BR2_PACKAGE_LXQT_POWERMANAGEMENT=y
BR2_PACKAGE_LXQT_CONFIG=y
BR2_PACKAGE_LXQT_QTPLUGIN=y
BR2_PACKAGE_LXQT_THEMES=y
BR2_PACKAGE_LXQT_ABOUT=y
BR2_PACKAGE_PCMANFM_QT=y
# archive manager (pcmanfm-qt: right-click > Extract), with the tools it uses
BR2_PACKAGE_LXQT_ARCHIVER=y
BR2_PACKAGE_P7ZIP=y
BR2_PACKAGE_P7ZIP_7ZA=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_ZIP=y
# GNU tar: BusyBox tar has no -z/-J/--use-compress-program (the archiver needs them)
BR2_PACKAGE_TAR=y
BR2_PACKAGE_QTERMINAL=y
# graphical login screen (autologin at boot, the login screen after logging out)
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_LIGHTDM=y
BR2_PACKAGE_LIGHTDM_GTK_GREETER=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_X11=y
BR2_PACKAGE_ML_SETTINGS=y
BR2_PACKAGE_ML_INSTALLER=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_LIBRSVG=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_MONO=y
BR2_PACKAGE_DEJAVU_SANS=y
BR2_PACKAGE_DEJAVU_SERIF=y
BR2_PACKAGE_LIBERATION=y
BR2_PACKAGE_LIBERATION_MONO=y
BR2_PACKAGE_LIBERATION_SANS=y
BR2_PACKAGE_LIBERATION_SERIF=y
BR2_PACKAGE_ALSA_LIB=y
# sound tools in the base system: S20alsa restores/initialises the mixer at
# boot (laptop speakers start muted), Settings -> Sound tests with speaker-test
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# PulseAudio: Firefox (official build) has no ALSA output, only PulseAudio; the
# daemon is started per user when a program needs it and exits when idle
BR2_PACKAGE_PULSEAUDIO=y
# ALSA's default device through PulseAudio (/etc/asound.conf)
BR2_PACKAGE_ALSA_PLUGINS=y

# --- Browser: official Mozilla Firefox ESR build, shipped as an mlpkg module
BR2_PACKAGE_FIREFOX_BIN=y

# --- Images: squashfs root (xz); GRUB 2 (platforms in the arch fragment)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_XORRISO=y
