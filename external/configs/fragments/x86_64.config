# MicroLinux: x86_64 (64-bit Intel/AMD PCs)

# --- Architecture: baseline x86-64 (any 64-bit PC; the same baseline as RHEL 7)
BR2_x86_64=y
BR2_x86_x86_64=y

# --- Kernel: x86_64_defconfig + the fragments, bzImage (EFI stub: boots from BIOS and UEFI)
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/linux-common.fragment $(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/linux-x86_64.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y

# --- Firmware for common PC NICs / Wi-Fi / Bluetooth (Intel, Realtek, MediaTek)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3160=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3168=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_9377_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174A_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y

# --- GPU drivers (hardware OpenGL, e.g. for games): Mesa with LLVM.
#     Intel: iris (Gen8+/Broadwell and newer), crocus (Gen4-7); AMD Radeon:
#     radeonsi (GCN and newer), r600 (HD 2000-6000); NVIDIA: nouveau (all,
#     RTX through the GSP firmware); others: llvmpipe (fast software GL).
#     GBM lets Xorg use glamor (DRI3). AMD/NVIDIA firmware: repository.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
# Vulkan (games, programs using wgpu): Intel (anv), and lavapipe on any other GPU
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_GBM=y

# --- Boot loader: GRUB 2 for BIOS (i386-pc) and UEFI (x86_64-efi); the GRUB
#     tools on the target let ml-install set up BIOS boot on the installed disk
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat iso9660 part_msdos part_gpt biosdisk normal search search_fs_file search_fs_uuid search_label configfile echo test all_video vbe vga video_bochs video_cirrus gfxterm font gzio ls cat reboot halt sleep regexp minicmd"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/grub-embed-pc.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 iso9660 part_msdos part_gpt normal efi_gop efi_uga search search_fs_file search_fs_uuid search_label configfile echo test all_video gfxterm font gzio loadenv ls cat reboot halt sleep regexp minicmd chain"
# The built-in configs run before GRUB's script parser is loaded: plain
# commands only (no if/fi, no comments). UEFI: grub.cfg next to the loader
# (live medium, installed system, dual boot), else find the live medium.
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/grub-embed.cfg"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# --- Secure Boot: Microsoft-signed shim (Debian); post-image.sh signs GRUB and
#     the kernel with keys/secureboot (see docs/SECUREBOOT.md)
BR2_PACKAGE_SHIM_SIGNED_BIN=y
