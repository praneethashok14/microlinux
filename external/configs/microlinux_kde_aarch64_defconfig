# MicroLinux aarch64 (kde edition) - Buildroot defconfig. GENERATED by scripts/gen-defconfigs.sh
# from configs/fragments/{aarch64,common,kde,repo}.config: edit those.
# Build:  make BR2_EXTERNAL=<src>/external microlinux_kde_aarch64_defconfig && make

# MicroLinux: aarch64 (64-bit ARM)

# --- Architecture: generic ARMv8.0-A so the image runs on any arm64 CPU
BR2_aarch64=y
BR2_cortex_a53=y

# --- Kernel: arm64 defconfig trimmed by the fragments, EFI zboot image
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/linux-common.fragment $(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/linux-aarch64.fragment"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="vmlinuz.efi"

# --- Firmware for common NICs / Wi-Fi / Bluetooth found on arm64 boards and laptops
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
