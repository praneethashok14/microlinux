# --- Boot loader: GRUB 2 arm64-efi (arm64 has no BIOS)
BR2_TARGET_GRUB2_ARM64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 iso9660 part_msdos part_gpt normal efi_gop search search_fs_file search_fs_uuid search_label configfile echo test all_video gfxterm font gzio loadenv ls cat reboot halt sleep regexp minicmd chain"
# The built-in configs run before GRUB's script parser is loaded: plain
# commands only (no if/fi, no comments). UEFI: grub.cfg next to the loader
# (live medium, installed system, dual boot), else find the live medium.
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_MICROLINUX_PATH)/board/microlinux/grub-embed.cfg"

