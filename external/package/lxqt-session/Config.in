config BR2_PACKAGE_LXQT_SESSION
	bool "lxqt-session"
	select BR2_PACKAGE_LIBLXQT
	select BR2_PACKAGE_KF6_KWINDOWSYSTEM
	select BR2_PACKAGE_LAYER_SHELL_QT
	select BR2_PACKAGE_QTXDG_TOOLS
	select BR2_PACKAGE_XDG_USER_DIRS
	select BR2_PACKAGE_PROCPS_NG
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_QT6
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_WIDGETS
	select BR2_PACKAGE_QT6BASE_DBUS
	select BR2_PACKAGE_HOST_QT6TOOLS
	select BR2_PACKAGE_HOST_QT6TOOLS_LINGUIST_TOOLS
	help
	  LXQt session manager (startlxqt, lxqt-leave, autostart).

	  https://github.com/lxqt/lxqt-session
