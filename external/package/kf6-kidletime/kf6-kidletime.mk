KF6_KIDLETIME_VERSION = 6.32.0
KF6_KIDLETIME_SITE = https://download.kde.org/stable/frameworks/6.32
KF6_KIDLETIME_SOURCE = kidletime-$(KF6_KIDLETIME_VERSION).tar.xz
KF6_KIDLETIME_LICENSE = see LICENSES/
KF6_KIDLETIME_LICENSE_FILES = LICENSES
KF6_KIDLETIME_INSTALL_STAGING = YES
KF6_KIDLETIME_DEPENDENCIES = kf6-extra-cmake-modules libxcb qt6base xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-wm xlib_libX11
KF6_KIDLETIME_CONF_OPTS = $(KDE_CONF_OPTS) -DWITH_X11=ON
ifeq ($(BR2_PACKAGE_QT6WAYLAND),y)
KF6_KIDLETIME_DEPENDENCIES += qt6wayland wayland wayland-protocols kde-plasma-wayland-protocols
else
KF6_KIDLETIME_CONF_OPTS += -DWITH_WAYLAND=OFF
endif

$(eval $(cmake-package))
