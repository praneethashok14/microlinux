KF6_KWINDOWSYSTEM_VERSION = 6.32.0
KF6_KWINDOWSYSTEM_SITE = https://download.kde.org/stable/frameworks/6.32
KF6_KWINDOWSYSTEM_SOURCE = kwindowsystem-$(KF6_KWINDOWSYSTEM_VERSION).tar.xz
KF6_KWINDOWSYSTEM_LICENSE = see LICENSES/
KF6_KWINDOWSYSTEM_LICENSE_FILES = LICENSES
KF6_KWINDOWSYSTEM_INSTALL_STAGING = YES
KF6_KWINDOWSYSTEM_DEPENDENCIES = kf6-extra-cmake-modules libxcb qt6base xcb-util-cursor xcb-util-image xcb-util-keysyms xcb-util-wm xlib_libX11
KF6_KWINDOWSYSTEM_CONF_OPTS = $(KDE_CONF_OPTS)
ifeq ($(BR2_PACKAGE_QT6DECLARATIVE),y)
KF6_KWINDOWSYSTEM_DEPENDENCIES += qt6declarative
else
KF6_KWINDOWSYSTEM_CONF_OPTS += -DKWINDOWSYSTEM_QML=OFF
endif
ifeq ($(BR2_PACKAGE_QT6WAYLAND),y)
KF6_KWINDOWSYSTEM_DEPENDENCIES += qt6wayland wayland wayland-protocols kde-plasma-wayland-protocols
else
KF6_KWINDOWSYSTEM_CONF_OPTS += -DKWINDOWSYSTEM_WAYLAND=OFF
endif

$(eval $(cmake-package))
