config BR2_PACKAGE_FIREFOX_BIN
	bool "firefox-bin (official Mozilla build, as mlpkg module)"
	depends on BR2_aarch64 || BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_LIBGTK3_X11
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_XLIB_LIBXCOMPOSITE
	select BR2_PACKAGE_XLIB_LIBXDAMAGE
	select BR2_PACKAGE_XLIB_LIBXRANDR
	select BR2_PACKAGE_XLIB_LIBXTST
	select BR2_PACKAGE_ALSA_LIB
	help
	  Unmodified Firefox ESR binary release from Mozilla for Linux
	  aarch64 or x86_64. It is not installed into the root filesystem; it is
	  packaged as an mlpkg module (packages/firefox-*.mlp) that is
	  mounted at /opt/firefox. Mozilla permits redistribution of
	  unmodified official binaries; see docs/LICENSES.md.
