config BR2_PACKAGE_LXQT_ARCHIVER
	bool "lxqt-archiver"
	select BR2_PACKAGE_LIBFM_QT
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_QT6
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_WIDGETS
	select BR2_PACKAGE_HOST_QT6TOOLS
	select BR2_PACKAGE_HOST_QT6TOOLS_LINGUIST_TOOLS
	help
	  LXQt archive manager: opens, creates and extracts archives
	  (zip, 7z, tar.gz/xz/bz2/zst, ...) with the command-line tools.

	  https://github.com/lxqt/lxqt-archiver
