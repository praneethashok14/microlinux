config BR2_PACKAGE_LAYER_SHELL_QT
	bool "layer-shell-qt"
	depends on BR2_PACKAGE_QT6_GL_SUPPORTS # qt6wayland
	select BR2_PACKAGE_KF6_EXTRA_CMAKE_MODULES
	select BR2_PACKAGE_QT6WAYLAND
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_LIBXKBCOMMON
	help
	  LayerShellQt: lets Qt programs use the Wayland wlr-layer-shell
	  protocol (panels, docks). Needed to build LXQt; under X11 it
	  is only loaded, not used.

	  https://invent.kde.org/plasma/layer-shell-qt
