<?xml version="1.0"?>
<!-- MicroLinux desktop: JWM configuration. Users can copy it to ~/.jwmrc. -->
<JWM>
  <RootMenu onroot="13" height="24" label="MicroLinux">
    <Program icon="preferences-system" label="Settings">ml-settings</Program>
    <Separator/>
    <Program icon="utilities-terminal" label="Terminal">xterm</Program>
    <Program icon="system-file-manager" label="Files">pcmanfm</Program>
    <Program icon="web-browser" label="Firefox">firefox</Program>
    <Program icon="accessories-text-editor" label="Text editor (nano)">xterm -T "Text editor" -e nano</Program>
    <Separator/>
    <Menu icon="applications-other" label="All applications">
      <Include>exec:ml-menu</Include>
    </Menu>
    <Menu icon="applications-system" label="System">
      <Program icon="utilities-system-monitor" label="Task manager">xterm -T "Task manager" -e htop</Program>
      <Program icon="computer" label="System information">xterm -T "System information" -geometry 90x24 -hold -e ml-sysinfo</Program>
      <Program icon="computer" label="Hardware">xterm -T Hardware -geometry 110x40 -e sh -c 'sudo ml-hwinfo | less -R'</Program>
      <Program icon="network-wired" label="Network (terminal)">xterm -T Network -geometry 100x30 -e sh -c 'netcfg status; echo; netcfg test; echo; echo "Wi-Fi: sudo netcfg wifi-scan  /  sudo netcfg wifi SSID PASSWORD"; exec bash'</Program>
      <Program icon="bluetooth" label="Bluetooth">ml-settings bluetooth</Program>
      <Program icon="package-x-generic" label="Packages">ml-settings packages</Program>
      <Program icon="text-x-generic" label="System log">xterm -T "System log" -geometry 120x35 -e sudo ml-log -f</Program>
      <Program icon="drive-harddisk" label="Install MicroLinux to disk">xterm -T Installer -geometry 100x30 -e sh -c 'sudo ml-install; echo; printf "Press Enter to close"; read x'</Program>
    </Menu>
    <Menu icon="video-display" label="Display">
      <Include>exec:ml-display jwm-menu</Include>
    </Menu>
    <Separator/>
    <Restart icon="view-refresh" label="Restart desktop"/>
    <Exit icon="system-log-out" label="Log out" confirm="true"/>
    <Program icon="system-reboot" label="Reboot">sudo reboot</Program>
    <Program icon="system-shutdown" label="Power off">sudo poweroff</Program>
  </RootMenu>

  <Tray x="0" y="-1" height="32" autohide="off">
    <TrayButton icon="start-here" label=" MicroLinux">root:1</TrayButton>
    <Spacer width="6"/>
    <TrayButton icon="utilities-terminal" popup="Terminal">exec:xterm</TrayButton>
    <TrayButton icon="system-file-manager" popup="Files">exec:pcmanfm</TrayButton>
    <TrayButton icon="web-browser" popup="Firefox">exec:firefox</TrayButton>
    <TrayButton icon="preferences-system" popup="Settings">exec:ml-settings</TrayButton>
    <Spacer width="6"/>
    <TaskList maxwidth="240"/>
    <Pager labeled="true"/>
    <Dock/>
    <Clock format="%a %d %b  %H:%M"><Button mask="1">xterm -T Calendar -geometry 66x10 -hold -e cal -3</Button></Clock>
    <Spacer width="4"/>
  </Tray>

  <WindowStyle decorations="flat">
    <Font>DejaVu Sans-10:bold</Font>
    <Width>3</Width>
    <Height>26</Height>
    <Corner>4</Corner>
    <Foreground>#c8ccd4</Foreground>
    <Background>#3b4252</Background>
    <Outline>#2e3440</Outline>
    <Opacity>1.0</Opacity>
    <Active>
      <Foreground>#ffffff</Foreground>
      <Background>#5e81ac</Background>
      <Outline>#4c6a94</Outline>
      <Opacity>1.0</Opacity>
    </Active>
  </WindowStyle>
  <TrayStyle decorations="flat">
    <Font>DejaVu Sans-10</Font>
    <Background>#2e3440</Background>
    <Foreground>#eceff4</Foreground>
    <Opacity>0.96</Opacity>
  </TrayStyle>
  <TaskListStyle list="desktop" group="false">
    <Font>DejaVu Sans-10</Font>
    <Foreground>#d8dee9</Foreground>
    <Background>#3b4252</Background>
    <Active>
      <Foreground>#ffffff</Foreground>
      <Background>#4c566a</Background>
    </Active>
  </TaskListStyle>
  <PagerStyle>
    <Outline>#2e3440</Outline>
    <Foreground>#4c566a</Foreground>
    <Background>#3b4252</Background>
    <Text>#eceff4</Text>
    <Active>
      <Foreground>#5e81ac</Foreground>
      <Background>#5e81ac</Background>
    </Active>
  </PagerStyle>
  <MenuStyle decorations="flat">
    <Font>DejaVu Sans-10</Font>
    <Foreground>#eceff4</Foreground>
    <Background>#3b4252</Background>
    <Outline>#2e3440</Outline>
    <Active>
      <Foreground>#ffffff</Foreground>
      <Background>#5e81ac</Background>
    </Active>
    <Opacity>0.98</Opacity>
  </MenuStyle>
  <PopupStyle>
    <Font>DejaVu Sans-9</Font>
    <Foreground>#eceff4</Foreground>
    <Background>#4c566a</Background>
  </PopupStyle>

  <IconPath>/usr/share/icons/Adwaita/scalable/apps</IconPath>
  <IconPath>/usr/share/icons/Adwaita/scalable/places</IconPath>
  <IconPath>/usr/share/icons/Adwaita/scalable/devices</IconPath>
  <IconPath>/usr/share/icons/Adwaita/scalable/actions</IconPath>
  <IconPath>/usr/share/icons/Adwaita/scalable/mimetypes</IconPath>
  <IconPath>/usr/share/icons/Adwaita/scalable/legacy</IconPath>
  <!-- Adwaita keeps its full-colour application icons only at fixed sizes -->
  <IconPath>/usr/share/icons/Adwaita/48x48/legacy</IconPath>
  <IconPath>/usr/share/icons/Adwaita/symbolic/apps</IconPath>
  <IconPath>/usr/share/icons/Adwaita/symbolic/places</IconPath>
  <IconPath>/usr/share/icons/Adwaita/symbolic/devices</IconPath>
  <IconPath>/usr/share/icons/Adwaita/symbolic/actions</IconPath>
  <IconPath>/usr/share/icons/Adwaita/symbolic/status</IconPath>
  <IconPath>/usr/share/icons/hicolor/48x48/apps</IconPath>
  <IconPath>/usr/share/icons/hicolor/scalable/apps</IconPath>
  <IconPath>/opt/firefox/browser/chrome/icons/default</IconPath>

  <Desktops width="2" height="1">
    <Background type="gradient">#434c5e:#1b1f27</Background>
  </Desktops>

  <FocusModel>click</FocusModel>
  <SnapMode distance="10">border</SnapMode>
  <MoveMode>opaque</MoveMode>
  <ResizeMode>opaque</ResizeMode>
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <DoubleClickDelta>3</DoubleClickDelta>

  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="F2">window</Key>
  <Key mask="A" key="F10">maximize</Key>
  <Key mask="A" key="F1">root:1</Key>
  <Key key="Super_L">root:1</Key>
  <Key mask="4" key="Return">exec:xterm</Key>
  <Key mask="4" key="e">exec:pcmanfm</Key>
  <Key mask="4" key="w">exec:firefox</Key>
  <Key mask="4" key="i">exec:ml-settings</Key>
  <Key mask="4" key="Right">rdesktop</Key>
  <Key mask="4" key="Left">ldesktop</Key>
  <Key mask="CA" key="Delete">exec:xterm -T "Task manager" -e htop</Key>
</JWM>
