#!/bin/sh
# MicroLinux system start-up (run once by BusyBox init)
/bin/mount -t proc proc /proc 2>/dev/null
/bin/mount -o remount,rw / 2>/dev/null
/bin/mkdir -p /dev/pts /dev/shm
/bin/mount -a
/bin/mkdir -p /run/lock /var/log /run/mlpkg
/bin/ln -sf /proc/self/fd /dev/fd 2>/dev/null
[ -d /sys/firmware/efi/efivars ] && /bin/mount /sys/firmware/efi/efivars 2>/dev/null
/bin/hostname -F /etc/hostname
echo 0 > /proc/sys/kernel/printk_ratelimit 2>/dev/null

# quiet boot: keep kernel messages off the console once userspace is up
grep -qw quiet /proc/cmdline && echo "3 4 1 3" > /proc/sys/kernel/printk

RECOVERY=; grep -qw ml.recovery /proc/cmdline && RECOVERY=1

for i in /etc/init.d/S??*; do
	[ -x "$i" ] || continue
	if [ -n "$RECOVERY" ]; then
		# recovery mode: only logging and device management
		case "${i##*/}" in S01*|S02*|S10*) ;; *) continue ;; esac
	fi
	case "$i" in
		*.sh) ( trap - INT QUIT TSTP; set start; . "$i" ) ;;
		*) "$i" start ;;
	esac
done
[ -n "$RECOVERY" ] && echo "*** MicroLinux recovery mode: services and desktop disabled ***"
exit 0
