# MicroLinux /etc/inittab (BusyBox init)
::sysinit:/etc/init.d/rcS

# tty1: automatic login (user, or root in recovery mode); desktop starts from ~/.bash_profile
tty1::respawn:/sbin/getty -n -l /usr/libexec/ml-autologin 38400 tty1
tty2::respawn:/sbin/getty 38400 tty2
tty3::respawn:/sbin/getty 38400 tty3
# serial console (QEMU virt / servers / SBC debug UART); sleeps if absent
::respawn:/usr/libexec/ml-serial-getty
::respawn:/usr/libexec/ml-lightdm

::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
