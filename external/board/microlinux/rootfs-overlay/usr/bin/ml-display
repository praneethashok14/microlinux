#!/bin/sh
# ml-display - display resolution helper (X11 / xrandr)
#   ml-display list           outputs and modes
#   ml-display set WxH        set resolution of the first connected output
#   ml-display auto           apply ml.res=WxH from the kernel command line, or the preferred mode
out() { xrandr --query | awk '/ connected/ {print $1; exit}'; }
case "$1" in
	list) xrandr --query ;;
	set)  [ -n "$2" ] || { echo "usage: ml-display set WxH"; exit 1; }
	      o=$(out); xrandr --output "$o" --mode "$2" 2>/dev/null || {
	        # mode not advertised (common on virtual GPUs): add it with a CVT modeline
	        w=${2%x*}; h=${2#*x}; name="${w}x${h}_ml"
	        if command -v cvt >/dev/null; then ml=$(cvt "$w" "$h" | sed -n 's/^Modeline "[^"]*" //p')
	        else echo "mode $2 not available on $o"; exit 1; fi
	        xrandr --newmode "$name" $ml 2>/dev/null; xrandr --addmode "$o" "$name" && xrandr --output "$o" --mode "$name"; }
	      mkdir -p "$HOME/.config"; echo "$2" > "$HOME/.config/ml-resolution" ;;
	auto) r=$(sed -n 's/.*ml\.res=\([0-9]*x[0-9]*\).*/\1/p' /proc/cmdline)
	      [ -z "$r" ] && [ -f "$HOME/.config/ml-resolution" ] && r=$(cat "$HOME/.config/ml-resolution")
	      if [ -n "$r" ]; then "$0" set "$r"; else xrandr --output "$(out)" --auto 2>/dev/null; fi ;;
	*) sed -n '2,5s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
