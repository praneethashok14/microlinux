#!/bin/sh
# el7-chroot / el10-chroot / deb-chroot - enter a complete userspace of
# another Linux system
#
#   sudo el7-chroot [COMMAND [ARGS...]]      RHEL/CentOS 7, /opt/el7
#   sudo el10-chroot [COMMAND [ARGS...]]     RHEL 10 / AlmaLinux 10, /opt/el10
#   sudo deb-chroot [COMMAND [ARGS...]]      Debian 13, /opt/debian
#                                            default command: /bin/bash -l
#
# Runs inside a private mount namespace: the runtime (read-only) is overlaid
# with a tmpfs so it is writable, /dev /proc /sys /tmp /home /root and the
# network configuration are bound in. Everything is torn down when the command
# exits. Set EL7_PERSIST / EL10_PERSIST / DEB_PERSIST=/path/to/dir to keep
# changes made inside, for example packages installed with
#   rpm -ivh /home/USER/Downloads/NAME.rpm      (el10-chroot)
#   dpkg -i /home/USER/Downloads/NAME.deb       (deb-chroot)
me=${0##*/}
case "$me" in
	el10-*) N=el10 R=${EL10_ROOT:-/opt/el10} PERSIST=$EL10_PERSIST L=C.UTF-8 pkg=el10-runtime ;;
	deb-*)  N=deb R=${DEB_ROOT:-/opt/debian} PERSIST=$DEB_PERSIST L=C.UTF-8 pkg=debian-runtime ;;
	*)      N=el7 R=${EL7_ROOT:-/opt/el7} PERSIST=$EL7_PERSIST L=C pkg=el7-runtime ;;
esac
[ "$(id -u)" = 0 ] || { echo "$me: must be run as root (sudo $me)" >&2; exit 1; }
[ -x "$R/usr/bin/bash" ] || { echo "$me: runtime not found at $R (mlpkg install $pkg)" >&2; exit 1; }

if [ -z "$EL_CHROOT_INNER" ]; then
	export EL_CHROOT_INNER=1
	exec unshare --mount --propagation private -- "$0" "$@"
fi

W=$(mktemp -d /run/$N-chroot.XXXXXX)
if [ -n "$PERSIST" ]; then mkdir -p "$PERSIST"; mount --bind "$PERSIST" "$W"
else mount -t tmpfs -o mode=0755 ${N}rw "$W"; fi
mkdir -p "$W/upper" "$W/work" "$W/root"
mount -t overlay overlay -o "lowerdir=$R,upperdir=$W/upper,workdir=$W/work" "$W/root"
C=$W/root
for d in dev proc sys tmp home root run etc/ssl; do mkdir -p "$C/$d"; done
mount --rbind /dev "$C/dev"
mount -t proc proc "$C/proc"
mount --rbind /sys "$C/sys"
mount --bind /tmp "$C/tmp"
mount --bind /home "$C/home"
mount --bind /root "$C/root"
mount --bind /etc/ssl "$C/etc/ssl"
cp -L /etc/resolv.conf "$C/etc/resolv.conf" 2>/dev/null || true
cp /etc/hosts "$C/etc/hosts" 2>/dev/null || true
grep -q "^$(id -un):" "$C/etc/passwd" || getent passwd 2>/dev/null >> "$C/etc/passwd" || cat /etc/passwd >> "$C/etc/passwd"

[ $# -gt 0 ] || set -- /bin/bash -l
exec chroot "$C" /usr/bin/env -i HOME=/root TERM="${TERM:-linux}" LC_ALL=$L \
	PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin PS1="[$N \\u@\\h \\W]\\$ " "$@"
