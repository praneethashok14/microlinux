# Applied on top of Buildroot's default busybox config.
CONFIG_CTTYHACK=y
CONFIG_SWITCH_ROOT=y
CONFIG_FINDFS=y
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_ISO9660=y
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_FEATURE_VOLUMEID_SQUASHFS=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FLOAT_DURATION=y
CONFIG_UDHCPC=y
CONFIG_SYSLOGD=y
CONFIG_FEATURE_ROTATE_LOGFILE=y
CONFIG_FEATURE_IPC_SYSLOG=y
CONFIG_LOGREAD=y
CONFIG_FEATURE_LOGREAD_REDUCED_LOCKING=y
CONFIG_KLOGD=y
CONFIG_NTPD=y
CONFIG_ADDUSER=y
CONFIG_ADDGROUP=y
CONFIG_DELUSER=y
CONFIG_DELGROUP=y
CONFIG_FEATURE_ADDUSER_TO_GROUP=y
CONFIG_FEATURE_DEL_USER_FROM_GROUP=y
CONFIG_PASSWD=y
CONFIG_CHPASSWD=y
CONFIG_SU=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_SHA256SUM=y
CONFIG_SHA512SUM=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_SETSID=y
CONFIG_VI=y
CONFIG_WATCH=y
CONFIG_FREE=y
CONFIG_LSOF=y
CONFIG_TIMEOUT=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_PIDOF=y
