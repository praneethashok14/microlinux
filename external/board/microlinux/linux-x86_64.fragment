# MicroLinux kernel fragment for x86_64 (after linux-common.fragment).
# Goal: any 64-bit PC or VM, booted from BIOS or UEFI (bzImage EFI stub).

CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y

# --- Display: UEFI GOP or BIOS VESA mode (set by GRUB) -> simpledrm, then the
#     native KMS driver takes over: QEMU/Bochs, VMware, VirtualBox, Intel
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_EFI is not set
# CONFIG_FB_VESA is not set
CONFIG_DRM_I915=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_CIRRUS_QEMU=m

# --- Storage: legacy IDE/SATA (QEMU pc, older PCs), SD card readers
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX_PCI=m

# --- Virtualisation guests
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VMXNET3=m
CONFIG_VMWARE_PVSCSI=m

# --- Network: Intel / Realtek / Atheros wired, Intel / Atheros Wi-Fi
#     (Realtek rtw88/rtw89 and MediaTek are in the common fragment)
CONFIG_E1000=m
CONFIG_IGC=m
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_BT_INTEL=m

# --- Laptop support: ACPI buttons/battery/backlight
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_VIDEO=m
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y

# --- Touchpads and touchscreens on I2C (most laptops since ~2015): Intel LPSS,
#     the DesignWare I2C controller, and the pin controller that delivers their
#     interrupts (built in: needed before the HID drivers bind)
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m

# --- Laptop sound: HDA codecs (Realtek ALC269 covers most laptops since 2012,
#     e.g. ALC256/ALC3246), Conexant, Cirrus, IDT, Analog, HDMI/DisplayPort
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ALC260=m
CONFIG_SND_HDA_CODEC_ALC262=m
CONFIG_SND_HDA_CODEC_ALC268=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_ALC662=m
CONFIG_SND_HDA_CODEC_ALC680=m
CONFIG_SND_HDA_CODEC_ALC861=m
CONFIG_SND_HDA_CODEC_ALC861VD=m
CONFIG_SND_HDA_CODEC_ALC880=m
CONFIG_SND_HDA_CODEC_ALC882=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_CS420X=m
CONFIG_SND_HDA_CODEC_CS421X=m
CONFIG_SND_HDA_CODEC_CS8409=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI_ATI=m
CONFIG_SND_HDA_CODEC_HDMI_NVIDIA=m

# --- Laptop hotkeys, airplane-mode key, 2-in-1 tablet mode, backlight (Dell, Intel)
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_WMI=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_RBTN=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m

# --- RTC
CONFIG_RTC_DRV_CMOS=y
